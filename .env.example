# Required
OPENAI_API_KEY=sk-...

# Database
DATABASE_URL=postgresql+asyncpg://adresearch:adresearch@localhost:5432/adresearchai

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# App
ENV=development
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1

# Media storage (local path for dev; swap for S3 key prefix in prod)
MEDIA_DIR=./media
